rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // =========================================================================
    // 0. 授權 Email 白名單檢驗
    // =========================================================================
    function isAllowedUser() {
      return request.auth != null && 
             request.auth.token.email in [
               // 部署至 Firebase 後台時，請在此填入您的授權管理員 Google 信箱
               'YOUR_ADMIN_EMAIL@gmail.com'
               // , 'partner@gmail.com'
             ];
    }

    // =========================================================================
    // 1. 公開展示層：全域參拜紀錄
    // =========================================================================
    match /pilgrimages/{templeId} {
      // 訪客公開讀取（支援地圖與廟宇名冊瀏覽）
      allow read: if true;

      // 寫入/更新/刪除：嚴格限制為白名單授權帳號
      allow create, update, delete: if isAllowedUser();
    }

    // =========================================================================
    // 2. 個人使用者私有空間 (個人紀錄、路線與備份)
    // =========================================================================
    match /users/{userId} {
      // 僅允許符合白名單且為本人 UID 之帳號存取
      allow read, write: if isAllowedUser() && request.auth.uid == userId;

      // 個人參拜打卡紀錄子集合
      match /records/{templeId} {
        allow read, write: if isAllowedUser() && request.auth.uid == userId;
      }

      // 個人規劃行程路線子集合
      match /itineraries/{itineraryId} {
        allow read, write: if isAllowedUser() && request.auth.uid == userId;
      }

      // 萬用子集合遞迴保護
      match /{allChildren=**} {
        allow read, write: if isAllowedUser() && request.auth.uid == userId;
      }
    }
  }
}
