rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 參拜足跡紀錄集合
    match /pilgrimages/{templeId} {
      // 1. 公開唯讀瀏覽：所有人皆可檢視參拜成果與地圖
      allow read: if true;

      // 2. 新增權限：必須為登入使用者、強制綁定 UID，並實施欄位格式與長度檢查
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.status in ['visited', 'planned', 'unvisited']
                    && (!('notes' in request.resource.data) || (request.resource.data.notes is string && request.resource.data.notes.size() <= 5000));

      // 3. 修改權限：僅限原始建立者（比對 UID），防止他人越權篡改或破壞 (BOLA 防護)
      allow update: if request.auth != null
                    && (resource.data.userId == request.auth.uid || !('userId' in resource.data))
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.status in ['visited', 'planned', 'unvisited']
                    && (!('notes' in request.resource.data) || (request.resource.data.notes is string && request.resource.data.notes.size() <= 5000));

      // 4. 刪除權限：僅限原始建立者
      allow delete: if request.auth != null
                    && (resource.data.userId == request.auth.uid || !('userId' in resource.data));
    }
  }
}
